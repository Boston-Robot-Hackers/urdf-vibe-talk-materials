<?xml version="1.0"?>
<robot name="simple_diffbot">

    <!-- Base footprint -->
    <link name="base_footprint">
        <visual>
            <geometry>
                <sphere radius="0.01"/>
            </geometry>
        </visual>
    </link>

    <link name="base_link">
        <visual>
            <geometry>
                <cylinder radius="0.15" length="0.03"/>
            </geometry>
            <material>
                <color rgba="0.35 0.40 0.45 1.0"/>
            </material>
        </visual>
    </link>

    <joint name="base_footprint_to_base_link" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
    </joint>

    <link name="lidar">
        <origin xyz="0 0 0.045" rpy="0.0 0 0"/>
        <visual>
            <geometry>
                <box size="0.1 0.03 0.01" />
            </geometry>
        </visual>
    </link>

    <joint name="lidar_joint" type="fixed">
        <parent link="base_link"/>
        <child link="lidar"/>
        <origin xyz="0 0 0.045" rpy="0.0 0 1.6"/>
    </joint>

</robot>
