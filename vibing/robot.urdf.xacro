<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="vibe_robot">

  <!-- Parameters for easy customization -->
  <xacro:property name="plate_diameter" value="0.280"/>  <!-- 280mm -->
  <xacro:property name="plate_thickness" value="0.003"/>  <!-- 3mm acrylic -->
  <xacro:property name="plate_radius" value="${plate_diameter/2}"/>

  <xacro:property name="bottom_plate_height" value="0.065"/>  <!-- 65mm from base_footprint -->
  <xacro:property name="top_plate_height" value="0.125"/>  <!-- 125mm from base_footprint -->

  <xacro:property name="base_link_x" value="0.085"/>  <!-- 85mm -->
  <xacro:property name="base_link_y" value="0.0"/>
  <xacro:property name="base_link_z" value="0.065"/>  <!-- 65mm -->

  <xacro:property name="support_post_radius" value="0.005"/>  <!-- 5mm radius -->
  <xacro:property name="support_post_bottom" value="0.055"/>  <!-- 10mm below bottom plate -->
  <xacro:property name="support_post_top" value="0.135"/>  <!-- 10mm above top plate -->
  <xacro:property name="support_post_height" value="${support_post_top - support_post_bottom}"/>

  <xacro:property name="wheel_radius" value="0.03125"/>  <!-- 62.5mm diameter / 2 -->
  <xacro:property name="wheel_width" value="0.024"/>  <!-- 24mm -->
  <xacro:property name="wheel_separation" value="0.215"/>  <!-- 215mm wheelbase -->

  <!-- Colors -->
  <material name="clear_acrylic">
    <color rgba="0.9 0.9 0.9 0.5"/>
  </material>

  <material name="blue">
    <color rgba="0.0 0.0 1.0 1.0"/>
  </material>

  <material name="light_blue">
    <color rgba="0.5 0.7 1.0 1.0"/>
  </material>

  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <material name="red">
    <color rgba="1.0 0.0 0.0 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <!-- Base footprint (ground projection) -->
  <link name="base_footprint">
    <visual>
      <geometry>
        <sphere radius="0.01"/>  <!-- 1cm sphere -->
      </geometry>
      <material name="grey"/>
    </visual>
  </link>

  <!-- Base link (main robot body, rotation center) -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="${base_link_x} ${base_link_y} ${base_link_z}" rpy="0 0 0"/>
  </joint>

  <!-- Bottom plate (clear acrylic) -->
  <link name="bottom_plate">
    <visual>
      <geometry>
        <cylinder radius="${plate_radius}" length="${plate_thickness}"/>
      </geometry>
      <material name="clear_acrylic"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${plate_radius}" length="${plate_thickness}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.005" ixy="0.0" ixz="0.0" iyy="0.005" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="base_footprint_to_bottom_plate" type="fixed">
    <parent link="base_footprint"/>
    <child link="bottom_plate"/>
    <origin xyz="0 0 ${bottom_plate_height}" rpy="0 0 0"/>
  </joint>

  <!-- Top plate (clear acrylic) -->
  <link name="top_plate">
    <visual>
      <geometry>
        <cylinder radius="${plate_radius}" length="${plate_thickness}"/>
      </geometry>
      <material name="clear_acrylic"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${plate_radius}" length="${plate_thickness}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.005" ixy="0.0" ixz="0.0" iyy="0.005" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="base_footprint_to_top_plate" type="fixed">
    <parent link="base_footprint"/>
    <child link="top_plate"/>
    <origin xyz="0 0 ${top_plate_height}" rpy="0 0 0"/>
  </joint>

  <!-- Support Post 1 (blue) -->
  <link name="support_post_1">
    <visual>
      <geometry>
        <cylinder radius="${support_post_radius}" length="${support_post_height}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${support_post_radius}" length="${support_post_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="base_link_to_support_post_1" type="fixed">
    <parent link="base_link"/>
    <child link="support_post_1"/>
    <origin xyz="0.040 0 ${(support_post_bottom + support_post_top)/2 - base_link_z}" rpy="0 0 0"/>
  </joint>

  <!-- Support Post 2 (blue) -->
  <link name="support_post_2">
    <visual>
      <geometry>
        <cylinder radius="${support_post_radius}" length="${support_post_height}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${support_post_radius}" length="${support_post_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="support_post_1_to_support_post_2" type="fixed">
    <parent link="support_post_1"/>
    <child link="support_post_2"/>
    <origin xyz="-0.180 0.070 0" rpy="0 0 0"/>
  </joint>

  <!-- Support Post 3 (blue) -->
  <link name="support_post_3">
    <visual>
      <geometry>
        <cylinder radius="${support_post_radius}" length="${support_post_height}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${support_post_radius}" length="${support_post_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="support_post_1_to_support_post_3" type="fixed">
    <parent link="support_post_1"/>
    <child link="support_post_3"/>
    <origin xyz="-0.180 -0.070 0" rpy="0 0 0"/>
  </joint>

  <!-- Left Wheel -->
  <link name="left_wheel">
    <visual>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 ${wheel_separation/2} ${wheel_radius - base_link_z}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Right Wheel -->
  <link name="right_wheel">
    <visual>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 ${-wheel_separation/2} ${wheel_radius - base_link_z}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Lidar (light blue) -->
  <link name="lidar">
    <visual>
      <geometry>
        <cylinder radius="0.035" length="0.04"/>
      </geometry>
      <material name="light_blue"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.035" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="base_link_to_lidar" type="fixed">
    <parent link="base_link"/>
    <child link="lidar"/>
    <origin xyz="-0.040 0 0.130" rpy="0 0 0"/>
  </joint>

  <!-- IMU (grey) -->
  <link name="imu">
    <visual>
      <geometry>
        <box size="0.03 0.03 0.01"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.03 0.03 0.01"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="base_link_to_imu" type="fixed">
    <parent link="base_link"/>
    <child link="imu"/>
    <origin xyz="-0.040 0 0.020" rpy="0 0 0"/>
  </joint>

  <!-- Front Marker (red) -->
  <link name="front_marker">
    <visual>
      <geometry>
        <sphere radius="0.01"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.01"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="base_link_to_front_marker" type="fixed">
    <parent link="base_link"/>
    <child link="front_marker"/>
    <origin xyz="0.015 0 0.050" rpy="0 0 0"/>
  </joint>

</robot>
